@startuml
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam activity {
 BackgroundColor #EDF3FA
 BorderColor #25415D
 DiamondBackgroundColor #FFF5DB
 DiamondBorderColor #8D743B
}
skinparam swimlaneWidth 230
title СМО, вариант 5 – событийный процесс с дорожками
|Движок и календарь|
|Источники|
|Постановка|
|Буфер|
|Выбор и пакет|
|Серверы|
|Статистика|
|Движок и календарь|
start
:Инициализировать источники,
пустой буфер и свободные серверы;
|Источники|
:Для каждого источника вычислить
первое поступление по ИЗ1;
|Движок и календарь|
:Добавить первые события;
repeat
 :Извлечь группу ближайшего времени t;
 :Установить modelTime = t;
 while (Есть необработанное завершение t?) is (да)
  |Серверы|
  :finish(t) на указанном сервере;
  :Освободить сервер;
  |Выбор и пакет|
  :Отметить участника SERVED;
  |Статистика|
  :Учесть завершение и сохранить
состояние после события (ОД2);
  |Движок и календарь|
 endwhile (нет)
 while (Есть необработанное поступление t?) is (да)
  |Источники|
  :generate(t), бесконечный источник ИБ;
  |Статистика|
  :Учесть поступление;
  :Сохранить состояние GENERATED;
  |Постановка|
  :accept(request);
  |Буфер|
  :Поиск свободной ячейки по кругу
от указателя p (Д1ОЗ1);
  if (Свободная ячейка j найдена?) then (да)
   :Записать новую заявку в j;
  else (нет)
   :Вытеснить заявку под p (Д1ОО1);
   :Записать новую заявку
на освободившееся место j = p;
  endif
  :Перевести p на следующую за j ячейку;
  |Выбор и пакет|
  if (Вытеснена заявка активного пакета?) then (да)
   :Отметить её REFUSED;
   :Сохранить фиксированный состав;
  else (нет)
  endif
  |Статистика|
  :Учесть вставку и возможный отказ;
  :Сохранить состояние
INSERTED_OR_EVICTED;
  |Источники|
  :nextArrivalAt(t) = t + Exp(lambda);
  |Движок и календарь|
  :Запланировать следующее поступление;
  |Статистика|
  :Сохранить состояние
ARRIVAL_SCHEDULED;
  |Движок и календарь|
 endwhile (нет)
 |Выбор и пакет|
 if (Есть активный пакет?) then (да)
  if (Все участники SERVED или REFUSED?) then (да)
   :Закрыть пакет;
   :activePackage = null;
  else (нет)
  endif
 else (нет)
 endif
 while (Есть свободный сервер?) is (да)
  |Серверы|
  :lowestFree() по Д2П1:
минимальный номер свободного сервера;
  |Выбор и пакет|
  if (activePackage == null?) then (да)
   |Буфер|
   if (Есть ожидающие заявки?) then (да)
    :Выбрать источник:
вуз, иначе школа, иначе колледж;
    :Получить все его ожидающие заявки
в порядке FIFO;
    |Выбор и пакет|
    :Зафиксировать состав нового пакета (Д2Б5);
   else (нет)
    |Выбор и пакет|
    :Назначение отсутствует;
    break
   endif
  else (нет)
  endif
  if (В активном пакете есть WAITING?) then (да)
   :nextWaiting(): только WAITING;
   |Буфер|
   :Извлечь выбранную заявку;
   :Освободить ячейку;
   :Указатель постановки не менять;
   |Серверы|
   :start(request, packageId, t)
на выбранном сервере;
   :endAt = t + Uniform(a, b) (ПЗ2);
   |Выбор и пакет|
   :Отметить участника RUNNING;
   |Статистика|
   :Учесть начало обслуживания;
   |Движок и календарь|
   :Запланировать завершение на endAt;
   |Статистика|
   :Сохранить состояние STARTED;
   |Выбор и пакет|
  else (нет)
   :Сохранить активный пакет,
пока есть RUNNING;
   :Свободные серверы ждут;
   break
  endif
 endwhile (нет)
 |Статистика|
 :Сохранить состояние DISPATCH_FINISHED;
 |Движок и календарь|
repeat while (Условие остановки не выполнено?) is (да) not (нет)
|Статистика|
:Сформировать сводную таблицу (ОР1);
stop
@enduml
